#!/bin/sh
set -e

ROOT=$(git rev-parse --show-toplevel)

echo "🔍 [1/2] Checking Backend (TypeScript & Vitest)..."
cd "$ROOT/Backend"
npm run build || { echo "❌ Backend TypeScript build failed! Push aborted."; exit 1; }
npm test || { echo "❌ Backend tests failed! Push aborted."; exit 1; }

echo "🔍 [2/2] Checking Frontend (Vitest & Vite Build)..."
cd "$ROOT/Frontend"
npm test || { echo "❌ Frontend tests failed! Push aborted."; exit 1; }
npm run build || { echo "❌ Frontend production build failed! Push aborted."; exit 1; }

echo "✅ All checks passed! Proceeding with git push..."
